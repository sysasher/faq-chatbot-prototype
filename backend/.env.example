# Copy this file to .env and add your own API key.
# Leave both GEMINI_API_KEY and OPENAI_API_KEY empty to use the local FAQ-match response mode.
# If GEMINI_API_KEY is set, Gemini is used. Otherwise, if OPENAI_API_KEY is set, OpenAI is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUPPORT_EMAIL=support@example.com
